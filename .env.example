# 키는 이 예시 파일이 아니라 프로젝트 루트의 .env에 적습니다. .env는 Git에 포함되지 않습니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 서버 전용. 브라우저, 로그, 클라이언트 번들에 넣지 않는다. 일반 요청의 인증 헤더로 쓰지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 이후 단계. 이번 단계 서버는 이 값으로 외부 호출을 하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=

APP_ORIGIN=http://127.0.0.1:5173
PORT=5173

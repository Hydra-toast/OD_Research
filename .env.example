# 키는 이 예시 파일이 아니라 프로젝트 루트의 .env에 적습니다. .env는 Git에 포함되지 않습니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 서버 전용. 브라우저, 로그, 클라이언트 번들에 넣지 않는다. 일반 요청의 인증 헤더로 쓰지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# AI 설정. 단가 확인·전송 동의가 필요하며 검색 키와는 별개다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
AI_DAILY_BUDGET_USD=1.00
AI_PROJECT_BUDGET_USD=0.25
# OpenAlex 무료 키는 선택. 비어 있으면 공개 API를 사용한다. Semantic Scholar 키는 사용하지 않는다.
OPENALEX_API_KEY=
# 실제 사용하는 연락 이메일(Gmail 가능). 비밀번호나 API 키가 아니다.
CROSSREF_MAILTO=
# false는 외부 검색을 끄고 예시 모드만 사용한다.
SEARCH_ENABLED=true

APP_ORIGIN=http://127.0.0.1:5173
PORT=5173
